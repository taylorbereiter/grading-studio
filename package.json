    "speed": "node test/tools/speed.js",
    "preview": "npm run build && node test/preview.js"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "html2canvas": "1.4.1",
    "libheif-js": "1.23.5",
    "mammoth": "1.11.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0"
  },
  "engines": {
    "node": ">=22"
  }
}
