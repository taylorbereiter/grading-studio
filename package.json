{
  "name": "grading-studio",
  "version": "1.28.81",
  "private": true,
  "license": "MIT",
  "description": "Mark papers, plan lessons and hand work back, in the browser. Student work stays on the teacher's computer.",
  "scripts": {
    "build": "node build.js",
    "test": "node test/tools/run.js",
    "check": "npm run build && npm test",
    "screens": "node test/tools/screens.js",
    "saved-work": "node test/tools/saved-work.js",
    "speed": "node test/tools/speed.js",
    "preview": "npm run build && node test/preview.js",
    "next:build": "node next/build.js",
    "next:test": "node --test next/test/*.test.js",
    "next:check": "npm run next:build && npm run next:test",
    "next:docs": "node next/tools/saved-work-doc.js",
    "next:browser": "node --test --test-concurrency=1 next/test/browser/*.test.js",
    "next:shots": "node next/tools/gallery-shots.js"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "html2canvas": "1.4.1",
    "libheif-js": "1.23.5",
    "mammoth": "1.11.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "preact": "11.2.0",
    "puppeteer-core": "25.16.0"
  },
  "engines": {
    "node": ">=22"
  }
}
