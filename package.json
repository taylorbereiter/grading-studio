{
  "name": "grading-studio",
  "version": "1.28.12",
  "private": true,
  "license": "MIT",
  "description": "Mark papers, plan lessons and hand work back, in the browser. Student work stays on the teacher's computer.",
  "scripts": {
    "build": "node build.js",
    "test": "node test/tools/run.js",
